# ── Split Daily API server ──────────────────────────────────────────────
# Copy to server/.env (never commit the real file).

NODE_ENV=development
PORT=3000

# Postgres connection string (Neon, Supabase, RDS, local...). Neon: use ?sslmode=verify-full
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of THIS server (no trailing slash). Google redirects to
#   ${API_PUBLIC_URL}/api/auth/google/callback  ← add exactly this in Google Cloud Console
API_PUBLIC_URL=http://localhost:3000

# Google OAuth "Web application" client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: iOS / Android OAuth client IDs used by the in-app sign-in (tokens for these are accepted too).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Web app origins allowed to call the API and receive the sign-in redirect (comma-separated).
# Dev: Expo web runs on http://localhost:8081. Prod: e.g. https://app.example.com
WEB_APP_ORIGINS=http://localhost:8081

# Deep-link schemes allowed to receive the sign-in redirect on iOS/Android (matches app.config.ts).
APP_SCHEMES=ledgerly
# Allow Expo Go (exp://) redirects. Defaults to true in development, false in production.
# ALLOW_EXPO_GO_REDIRECTS=true

# Comma-separated emails that get the admin role on sign-in (optional).
ADMIN_EMAILS=

SESSION_TTL_DAYS=30

# Set to true behind a reverse proxy / PaaS load balancer (Render, Railway, Heroku, Nginx).
TRUST_PROXY=false

# Apply pending database migrations automatically when the server starts.
RUN_MIGRATIONS=false

# Optional: serve the exported web app (npm run build:web in the project root) from this server.
# WEB_DIST_DIR=../dist-web
