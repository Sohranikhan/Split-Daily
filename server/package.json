{
  "name": "ledgerly-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Split Daily API server (Express + tRPC + Postgres, MVC layout). Deployable on any Node 20+ host.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "build:cpanel": "node scripts/build-cpanel.mjs"
  },
  "dependencies": {
    "@trpc/server": "11.7.2",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
