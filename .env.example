# ── Split Daily app (Expo) ──────────────────────────────────────────────
# Only EXPO_PUBLIC_* values are bundled into the app. Server secrets go in server/.env.

# URL of the API server. Leave empty in local web dev (uses http://localhost:3000 automatically).
# Required for phone builds and when the web app is hosted separately from the API.
EXPO_PUBLIC_API_BASE_URL=

# Optional: override the iOS bundle id / Android package (default com.amir.splitdaily)
# APP_BUNDLE_ID=com.yourcompany.ledgerly

# In-app Google Sign-In (iOS/Android dev & release builds — not Expo Go).
# Web client ID = the same value as GOOGLE_CLIENT_ID in server/.env (it's public, not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the iOS OAuth client ID (Google Cloud → Credentials → iOS, bundle id com.amir.splitdaily)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# (leave empty if you don't build for iPhone — don't put placeholder text here)
